---
import Base from '../layouts/Base.astro';
import { articles, archiveGroups, articleUrl, dateText } from '../lib/content';
const all = await articles();
const years = archiveGroups(all);
---
<Base title="归档" section="归档">
  <div class="content-panel listing-page">
    <header class="page-heading"><h1>归档</h1><p>按年份浏览全部 {all.length} 篇文章。</p></header>
    <nav class="year-nav" aria-label="按年份浏览">{years.map(([year]) => <a href={`#year-${year}`}>{year}</a>)}</nav>
    {years.map(([year, entries]) => <section id={`year-${year}`} class="archive-year"><h2>{year}<span>{entries.length} 篇文章</span></h2><ol>{entries.map(entry => <li><time datetime={entry.data.date.toISOString()}>{dateText(entry.data.date).slice(5)}</time><a href={articleUrl(entry)}>{entry.data.title}</a><span class="archive-category">{entry.data.category}</span></li>)}</ol></section>)}
    {!all.length && <p class="empty-state">暂无归档文章</p>}
  </div>
</Base>
