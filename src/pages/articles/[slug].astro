---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { articles, articleUrl, taxonomyUrl, dateText } from '../../lib/content';
import '../../styles/reading.css';
import 'katex/dist/katex.min.css';
export async function getStaticPaths() {
  const all = await articles();
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, newer: all[i - 1], older: all[i + 1] } }));
}
const { entry, newer, older } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---
<Base title={entry.data.title} description={entry.data.summary} section="文章" article>
  <div class="reading-progress" role="progressbar" aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="reading-progress-fill"></span></div>
  <a class="back-link" href="/articles/"><span aria-hidden="true">←</span> 返回文章</a>
  <div class="reading-surface">
    <header class="article-header">
      <h1>{entry.data.title}</h1>
      <div class="meta"><time datetime={entry.data.date.toISOString()}>{dateText(entry.data.date)}</time><span aria-hidden="true">·</span><a href={taxonomyUrl('categories', entry.data.category)}>{entry.data.category}</a>{entry.data.updatedAt && <span>更新于 {dateText(entry.data.updatedAt)}</span>}</div>
      <p class="article-deck">{entry.data.summary}</p>
    </header>
    <div class="reading-toolbar">
      <div class="article-tags">{entry.data.tags.map(tag => <a href={taxonomyUrl('tags', tag)}>#{tag}</a>)}</div>
      <div class="reading-actions"><button id="copy-link">复制链接</button><button id="article-settings" aria-haspopup="dialog" aria-controls="settings-dialog">字号与主题</button></div>
      <output id="reading-percent" class="sr-only" aria-label="阅读百分比" aria-live="off">0%</output>
    </div>
    <div id="resume-reading" class="resume-reading" hidden><span id="resume-label"></span><button id="resume-button">继续阅读 <span aria-hidden="true">→</span></button></div>
    {toc.length >= 2 && <details class="toc"><summary><span>本文目录</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary><nav aria-label="本文目录"><ol>{toc.map(h => <li class:list={{ subheading: h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></details>}
    <article id="article-body" class="prose" data-article-id={entry.id}><Content /></article>
    <div class="article-end"><span>本文完</span><a href="/articles/">返回文章列表</a></div>
    {(newer || older) && <nav class="adjacent-articles" aria-label="相邻文章"><div>{newer && <a href={articleUrl(newer)}><span>较新一篇</span><strong>{newer.data.title}</strong></a>}</div><div>{older && <a href={articleUrl(older)}><span>较早一篇</span><strong>{older.data.title}</strong></a>}</div></nav>}
  </div>
  <script>import '../../scripts/reading';</script>
</Base>
