---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { articles, groups } from '../../lib/content';
export async function getStaticPaths() {
  return groups(await articles(), 'category').map(([name, entries]) => ({ params: { category: name }, props: { name, entries } }));
}
const { name, entries } = Astro.props;
---
<Base title={`${name} · 分类`} section="文章">
  <div class="content-panel listing-page">
    <a class="back-link" href="/articles/">← 全部文章</a>
    <header class="page-heading"><h1>{name}</h1><p>分类 · {entries.length} 篇文章</p></header>
    <ArticleList entries={entries} />
  </div>
</Base>
