---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { articles, groups } from '../../lib/content';
export async function getStaticPaths() {
  return groups(await articles(), 'tags').map(([name, entries]) => ({ params: { tag: name }, props: { name, entries } }));
}
const { name, entries } = Astro.props;
---
<Base title={`${name} · 标签`} section="文章"><div class="page-heading"><div><p class="eyebrow">TOPIC / 标签</p><h1><span class="muted">#</span>{name}<span class="count">{entries.length}</span></h1></div><a class="text-link" href="/tags/">全部标签 →</a></div><ArticleList entries={entries} /></Base>
