---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { articles, groups } from '../../lib/content';
export async function getStaticPaths() {
  return groups(await articles(), 'tags').map(([name, entries]) => ({ params: { tag: name }, props: { name, entries } }));
}
const { name, entries } = Astro.props;
---
<Base title={`${name} · 标签`} section="文章">
  <div class="content-panel listing-page">
    <a class="back-link" href="/tags/">← 全部标签</a>
    <header class="page-heading"><h1><span class="muted">#</span>{name}</h1><p>标签 · {entries.length} 篇文章</p></header>
    <ArticleList entries={entries} />
  </div>
</Base>
