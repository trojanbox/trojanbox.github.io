---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import TopicList from '../components/TopicList.astro';
import { articles, topics, groups, archiveGroups, taxonomyUrl } from '../lib/content';
const all = await articles();
const projects = await topics();
const categories = groups(all, 'category');
const tags = groups(all, 'tags');
---
<Base>
  <div class="page-kicker"><span>THE JOURNAL</span><span>随笔与专题，持续更新</span></div>
  <div class="home-columns">
    <section class="latest-section" aria-labelledby="latest-heading"><div class="section-heading"><h1 id="latest-heading">最近文章<span class="count">{String(all.length).padStart(2, '0')}</span></h1><span class="eyebrow">LATEST</span></div><ArticleList entries={all.slice(0, 6)} /><a class="all-link" href="/articles/">浏览全部文章 <span>→</span></a></section>
    <aside class="home-topics" aria-labelledby="topics-heading"><div class="section-heading"><h2 id="topics-heading">专题<span class="count">{String(projects.length).padStart(2, '0')}</span></h2><span class="eyebrow">EXPLORE</span></div><TopicList entries={projects.slice(0, 3)} /><a class="all-link" href="/topics/">全部专题 <span>→</span></a></aside>
  </div>
  <div class="exploration-grid">
    <section aria-labelledby="categories-heading"><div class="section-heading"><h2 id="categories-heading">按分类浏览</h2><span class="eyebrow">01 / CATEGORIES</span></div><div class="category-index">{categories.map(([name, items]) => <a href={taxonomyUrl('categories', name)}><span>{name}</span><span class="category-count">{String(items.length).padStart(2, '0')} <span aria-hidden="true">↗</span></span></a>)}{!categories.length && <p class="muted">分类会随文章一起出现。</p>}</div></section>
    <section aria-labelledby="tags-heading"><div class="section-heading"><h2 id="tags-heading">沿着话题阅读</h2><span class="eyebrow">02 / TOPICS</span></div><div class="tag-index">{tags.slice(0, 18).map(([tag]) => <a href={taxonomyUrl('tags', tag)}><span aria-hidden="true">#</span>{tag}</a>)}{!tags.length && <p class="muted">话题会随文章自然生长。</p>}</div><a class="small-link" href="/tags/">全部标签 →</a></section>
  </div>
  <section class="archive-strip" aria-labelledby="archive-heading"><div><p class="eyebrow">THE ARCHIVE</p><h2 id="archive-heading">时间里的文字</h2></div><div class="archive-years">{archiveGroups(all).slice(0, 4).map(([year, items]) => <a href={`/archive/#year-${year}`}><strong>{year}</strong><span>{items.length} 篇</span></a>)}</div><a class="text-link" href="/archive/">翻阅归档 →</a></section>
</Base>
