---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import TopicList from '../components/TopicList.astro';
import { articles, topics, groups, archiveGroups, taxonomyUrl } from '../lib/content';
const all = await articles();
const projects = await topics();
const categories = groups(all, 'category');
const tags = groups(all, 'tags');
---
<Base>
  <div class="home-layout">
    <div class="content-panel home-content">
      <section class="latest-section" aria-labelledby="latest-heading">
        <div class="section-heading"><h1 id="latest-heading">最近文章</h1><a class="text-link" href="/articles/">浏览全部文章</a></div>
        <ArticleList entries={all.slice(0, 6)} />
      </section>
      <section class="home-topics" aria-labelledby="topics-heading">
        <div class="section-heading"><h2 id="topics-heading">专题</h2><a class="text-link" href="/topics/">全部专题</a></div>
        <TopicList entries={projects.slice(0, 3)} headingLevel="h3" />
      </section>
    </div>
    <aside class="browse-sidebar" aria-label="内容浏览">
      <h2>浏览</h2>
      <section aria-labelledby="categories-heading"><h3 id="categories-heading">分类</h3><div class="category-index">{categories.map(([name, items]) => <a href={taxonomyUrl('categories', name)}><span>{name}</span><span class="category-count">{items.length} 篇</span></a>)}{!categories.length && <p class="muted">暂无分类</p>}</div></section>
      <section aria-labelledby="tags-heading"><h3 id="tags-heading">标签</h3><div class="tag-index">{tags.slice(0, 18).map(([tag]) => <a href={taxonomyUrl('tags', tag)}><span aria-hidden="true">#</span>{tag}</a>)}{!tags.length && <p class="muted">暂无标签</p>}</div><a class="small-link" href="/tags/">全部标签</a></section>
      <section aria-labelledby="archive-heading"><h3 id="archive-heading">归档</h3><div class="category-index">{archiveGroups(all).slice(0, 4).map(([year, items]) => <a href={`/archive/#year-${year}`}><span>{year}</span><span class="category-count">{items.length} 篇</span></a>)}</div><a class="small-link" href="/archive/">全部归档</a></section>
    </aside>
  </div>
</Base>
