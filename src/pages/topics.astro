---
import Base from '../layouts/Base.astro';
import TopicList from '../components/TopicList.astro';
import { topics } from '../lib/content';
const all = await topics();
---
<Base title="专题" section="专题">
  <div class="content-panel listing-page">
    <header class="page-heading"><h1>专题</h1><p>长期连载与独立项目，在各自的站点阅读。</p></header>
    <div class="topics-page"><TopicList entries={all} /></div>
  </div>
</Base>
