---
import { statusText, dateText, type Topic } from '../lib/content';
interface Props { entries: Topic[]; headingLevel?: 'h2' | 'h3' }
const { entries, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---
<div class="topic-list">
  {entries.map(entry => (
    <article class="topic-item">
      <Heading><a href={entry.data.url} target="_blank" rel="noopener noreferrer">{entry.data.title}</a></Heading>
      <p class="topic-summary">{entry.data.summary}</p>
      <div class="topic-footer">
        <div class="meta"><span class="topic-status"><span class:list={['status-dot', entry.data.status]} aria-hidden="true"></span>{statusText[entry.data.status]}</span><span aria-hidden="true">·</span><span>{entry.data.kind}</span>{entry.data.updatedAt && <span>更新于 {dateText(entry.data.updatedAt)}</span>}</div>
        <a class="text-link" href={entry.data.url} target="_blank" rel="noopener noreferrer">进入独立专题 <span aria-hidden="true">↗</span></a>
      </div>
    </article>
  ))}
  {entries.length === 0 && <p class="empty-state">暂无专题</p>}
</div>
