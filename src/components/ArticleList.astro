---
import { articleUrl, taxonomyUrl, dateText, type Article } from '../lib/content';
interface Props { entries: Article[]; compact?: boolean }
const { entries, compact = false } = Astro.props;
---
<div class:list={['article-list', { compact }]}>
  {entries.map(entry => (
    <article class="article-item">
      <h2><a href={articleUrl(entry)}>{entry.data.title}</a></h2>
      <p class="article-summary">{entry.data.summary}</p>
      <div class="article-item-meta">
        <div class="meta"><time datetime={entry.data.date.toISOString()}>{dateText(entry.data.date)}</time><span aria-hidden="true">·</span><a href={taxonomyUrl('categories', entry.data.category)}>{entry.data.category}</a></div>
        {entry.data.tags.length > 0 && <div class="article-tags">{entry.data.tags.map(tag => <a href={taxonomyUrl('tags', tag)}>#{tag}</a>)}</div>}
      </div>
    </article>
  ))}
  {entries.length === 0 && <div class="empty-state"><p>暂时还没有文章</p><span>可以先浏览已有专题。</span><a href="/topics/">浏览专题</a></div>}
</div>
