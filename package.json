{
  "name": "trojanbox-content-site",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "astro build && node scripts/build-offline.mjs",
    "preview": "node scripts/serve.mjs",
