    "@astrojs/rss": "4.0.19",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "astro": "7.2.0",
    "katex": "0.18.7",
    "mermaid": "12.0.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-math": "6.0.0",
    "sharp": "0.35.4",
